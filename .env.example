# Copier en « .env » (à la racine, là où l'on lance BrikIA) puis adapter.
# Aucun secret ici : les mots de passe se créent avec « create-user » ou « seed ».

# --- Réseau -------------------------------------------------------------
# 127.0.0.1 : poste local uniquement. Réseau d'usine : 0.0.0.0 ou l'adresse LAN du PC.
BRIKIA_HOST=127.0.0.1
BRIKIA_PORT=8000
# Noms / IP acceptés dans l'en-tête Host (séparés par des virgules). "*" = tout accepter.
# Déploiement LAN : BRIKIA_ALLOWED_HOSTS=192.168.1.20,brikia.usine.local
BRIKIA_ALLOWED_HOSTS=*

# --- HTTPS (reverse proxy local, voir docs/deploiement.md) ----------------
BRIKIA_BEHIND_PROXY=false
BRIKIA_COOKIE_SECURE=false

# --- Données -------------------------------------------------------------
BRIKIA_DATA_DIR=data
BRIKIA_MAX_UPLOAD_MB=50

# --- Simulation (phase 1, démonstration) ----------------------------------
BRIKIA_SIM_BLOCKS_PER_SECOND=40
# BRIKIA_SIM_FAULT_AT_PERCENT=50

# --- Règles de calepinage temporaires (JSON de surcharges, optionnel) -----
# BRIKIA_LAYOUT_RULES_FILE=config/layout_rules.json

# --- Seed de démonstration (optionnel ; sinon mots de passe générés) ------
# BRIKIA_SEED_CHEF_PASSWORD=
# BRIKIA_SEED_OPERATEUR_PASSWORD=
